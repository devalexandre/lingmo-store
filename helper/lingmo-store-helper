# The only part of Lingmo Store that runs as root, through
#   pkexec /usr/lib/lingmo-store/lingmo-store-helper <command> [args]
# (polkit action com.lingmo.store.manage-packages).
#
#   install <pkg>...          pacman -S --needed --noconfirm <pkg>...
#   remove <pkg>...           pacman -Rns --noconfirm <pkg>...
#   enable-multilib           uncomment [multilib] in pacman.conf (a backup is kept)
#   enable-repo <repo> [<pkg>...]
#                             add a known ArchLingmo repository to pacman.conf (a
#                             backup is kept; nothing is done when it's already
#                             there), sync only that repository's database and, when
#                             packages are given, pacman -S --needed --noconfirm
#                             <repo>/<pkg>... Only the repositories of KNOWN_REPOS
#                             below, with their fixed sections: no name or URL
#                             comes from the caller.
#   prepare-gaming <pkg>...   enable-multilib when needed, then
#                             pacman -Syu --needed --noconfirm <pkg>...
#                             and, when gamemode is among them, adds the user who
#                             ran pkexec (PKEXEC_UID) to the "gamemode" group
#
# Besides pacman's own output it prints "@@" lines the store turns into progress:
#   @@STEP <name>   multilib | repo | sync | install | remove | done
#   @@ERROR <code>  lock | name | protected | config | usage
#
# Testing without root: when not running as root and LINGMO_STORE_FAKE is set, pacman
# is simulated (LINGMO_STORE_FAKE: 1|ok, fail, offline, lock, cancel) and
# enable-multilib and enable-repo edit LINGMO_STORE_PACMAN_CONF (a copy of
# pacman.conf) instead of /etc/pacman.conf. As root those variables are ignored.

export LC_ALL=C
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

CONF=/etc/pacman.conf
LOCK=/var/lib/pacman/db.lck
FAKE=
if [ "$(id -u)" != 0 ] && [ -n "$LINGMO_STORE_FAKE" ]; then
    FAKE=$LINGMO_STORE_FAKE
    [ "$FAKE" = 1 ] && FAKE=ok
    CONF=${LINGMO_STORE_PACMAN_CONF:-}
    LOCK=/nonexistent/db.lck
    [ "$FAKE" = lock ] && LOCK=/dev/null
fi
SPEED=${LINGMO_STORE_FAKE_DELAY:-0.35}

# Removing these would leave the system unbootable or without a desktop
PROTECTED="base linux linux-lts linux-zen linux-hardened linux-firmware systemd glibc pacman sudo polkit
filesystem bash coreutils mesa xorg-server sddm kwin kwin-x11 flatpak lingmo-store lingmo-desktop
lingmo-core lingmo-dock lingmo-statusbar lingmo-launcher lingmo-filemanager lingmo-settings lingmo-updater
lingmoui networkmanager dbus grub efibootmgr"

fail() {
    echo "@@ERROR $1"
    shift
    echo "error: $*" >&2
    exit 2
}

check_names() {
    [ $# -gt 0 ] || fail usage "no packages given"
    for p in "$@"; do
        case $p in
        -*|*[!a-zA-Z0-9@._+-]*|'') fail name "invalid package name: $p" ;;
        esac
    done
}

check_lock() {
    if [ -e "$LOCK" ]; then
        echo "error: failed to init transaction (unable to lock database)"
        echo "@@ERROR lock"
        exit 1
    fi
}

multilib_enabled() {
    [ -n "$CONF" ] && [ -r "$CONF" ] || return 1
    grep -Eq '^[[:space:]]*\[multilib\][[:space:]]*$' "$CONF"
}

# Uncomments "#[multilib]" and its "#Include = ..." lines, or appends the section
edit_multilib() {
    awk '
        /^[[:space:]]*#[[:space:]]*\[multilib\][[:space:]]*$/ { print "[multilib]"; insec = 1; found = 1; next }
        insec && /^[[:space:]]*#[[:space:]]*(Include|Server)[[:space:]]*=/ { sub(/^[[:space:]]*#[[:space:]]*/, ""); print; next }
        insec && (/^[[:space:]]*$/ || /^[[:space:]]*#?[[:space:]]*\[/) { insec = 0 }
        { print }
        END {
            if (!found) {
                print ""
                print "[multilib]"
                print "Include = /etc/pacman.d/mirrorlist"
            }
        }' "$1"
}

enable_multilib() {
    echo "@@STEP multilib"
    if [ -z "$CONF" ]; then
        # fake mode without a pacman.conf copy: nothing to edit
        echo ":: Enabling the [multilib] repository (simulated)"
        return 0
    fi
    [ -w "$CONF" ] || fail config "cannot write $CONF"
    if multilib_enabled; then
        echo ":: [multilib] is already enabled in $CONF"
        return 0
    fi
    dir=$(dirname "$CONF")
    tmp=$(mktemp "$dir/.pacman.conf.lingmo-store.XXXXXX") || fail config "cannot create a temporary file in $dir"
    if ! edit_multilib "$CONF" > "$tmp"; then
        rm -f "$tmp"
        fail config "could not edit $CONF"
    fi
    # The result must still be a valid pacman.conf that lists [multilib]
    if ! pacman-conf --config "$tmp" --repo-list 2>/dev/null | grep -qx multilib; then
        rm -f "$tmp"
        fail config "the edited configuration is not valid; $CONF was not changed"
    fi
    backup="$CONF.lingmo-store-$(date +%Y%m%d-%H%M%S).bak"
    cp -p "$CONF" "$backup" || { rm -f "$tmp"; fail config "cannot back up $CONF"; }
    # Rewrite in place: keeps the file's owner and permissions
    cat "$tmp" > "$CONF" || { cp -p "$backup" "$CONF"; rm -f "$tmp"; fail config "cannot write $CONF"; }
    rm -f "$tmp"
    echo ":: Enabled the [multilib] repository in $CONF (backup: $backup)"
}

# The repositories enable-repo may add, with their exact sections. The Craft apps
# (storytold) are optional Store apps too big for GitHub Pages: their packages are
# the assets of a GitHub release (scripts/publish-craft.sh in the lingmo workspace).
KNOWN_REPOS="archlingmo-craft"

repo_section() {
    case $1 in
    archlingmo-craft)
        echo '[archlingmo-craft]'
        echo 'SigLevel = Optional TrustAll'
        echo 'Server = https://github.com/ArchLingmo/archlingmo-craft/releases/download/$arch' ;;
    *) return 1 ;;
    esac
}

repo_enabled() {
    [ -n "$CONF" ] && [ -r "$CONF" ] || return 1
    grep -Eq "^[[:space:]]*\[$1\][[:space:]]*\$" "$CONF"
}

enable_repo() {
    repo=$1
    echo "@@STEP repo"
    if [ -z "$CONF" ]; then
        echo ":: Enabling the [$repo] repository (simulated)"
        return 0
    fi
    if repo_enabled "$repo"; then
        echo ":: [$repo] is already enabled in $CONF"
        return 0
    fi
    [ -w "$CONF" ] || fail config "cannot write $CONF"
    dir=$(dirname "$CONF")
    tmp=$(mktemp "$dir/.pacman.conf.lingmo-store.XXXXXX") || fail config "cannot create a temporary file in $dir"
    {
        cat "$CONF"
        # a missing final newline would glue the section to the last line
        [ -z "$(tail -c 1 "$CONF")" ] || echo
        echo
        echo "# Added by Lingmo Store: optional apps from a separate ArchLingmo repository"
        repo_section "$repo"
    } > "$tmp" || { rm -f "$tmp"; fail config "could not edit $CONF"; }
    if ! pacman-conf --config "$tmp" --repo-list 2>/dev/null | grep -qx "$repo"; then
        rm -f "$tmp"
        fail config "the edited configuration is not valid; $CONF was not changed"
    fi
    backup="$CONF.lingmo-store-$(date +%Y%m%d-%H%M%S).bak"
    cp -p "$CONF" "$backup" || { rm -f "$tmp"; fail config "cannot back up $CONF"; }
    cat "$tmp" > "$CONF" || { cp -p "$backup" "$CONF"; rm -f "$tmp"; fail config "cannot write $CONF"; }
    rm -f "$tmp"
    echo ":: Enabled the [$repo] repository in $CONF (backup: $backup)"
}

# pacman -Sy for this repository alone: refreshing every database here would turn
# the next "pacman -S" into a partial upgrade. A throwaway pacman.conf with the
# system's [options] and only this repository's section.
sync_repo() {
    repo=$1
    echo "@@STEP sync"
    echo ":: Synchronizing the [$repo] package database..."
    if [ -n "$FAKE" ]; then
        sleep "$SPEED"
        echo " $repo downloading..."
        if [ "$FAKE" = offline ]; then
            echo "error: failed retrieving file '$repo.db' from github.com : Could not resolve host: github.com"
            echo "error: failed to synchronize all databases (download library error)"
            exit 1
        fi
        return 0
    fi
    sconf=$(mktemp /tmp/lingmo-store-sync.XXXXXX) || fail config "cannot create a temporary file"
    {
        awk '/^[[:space:]]*\[/ { in_options = ($0 ~ /^[[:space:]]*\[options\][[:space:]]*$/) } in_options' "$CONF"
        echo
        repo_section "$repo"
    } > "$sconf"
    pacman-conf --config "$sconf" --repo-list 2>/dev/null | grep -qx "$repo" \
        || { rm -f "$sconf"; fail config "could not prepare the database sync"; }
    pacman -Sy --config "$sconf"
    rc=$?
    rm -f "$sconf"
    [ $rc = 0 ] || exit $rc
}

AFTER_GAMEMODE=

# GameMode's polkit rule lets members of "gamemode" switch the CPU governor without a
# password; the group comes with the package (sysusers.d). Never fails the transaction.
after_install() {
    [ -n "$AFTER_GAMEMODE" ] || return 0
    if [ -n "$FAKE" ]; then
        echo ":: Adding you to the gamemode group (simulated)"
        return 0
    fi
    [ -n "$PKEXEC_UID" ] || return 0
    case $PKEXEC_UID in *[!0-9]*) return 0 ;; esac
    user=$(getent passwd "$PKEXEC_UID" | cut -d: -f1)
    [ -n "$user" ] || return 0
    getent group gamemode >/dev/null || return 0
    if id -nG "$user" | tr ' ' '\n' | grep -qx gamemode; then
        return 0
    fi
    echo ":: Adding $user to the gamemode group"
    gpasswd -a "$user" gamemode >/dev/null || echo "warning: could not add $user to the gamemode group"
    return 0
}

fake_pacman() {
    # fake_pacman <sync:0|1> <verb> <pkg>...
    sync=$1 verb=$2
    shift 2
    sleep 0.6   # "authentication"
    if [ "$FAKE" = cancel ]; then
        echo "Error executing command as another user: Request dismissed"
        exit 126
    fi
    if [ "$sync" = 1 ]; then
        echo "@@STEP sync"
        echo ":: Synchronizing package databases..."
        sleep "$SPEED"
        for r in core extra multilib; do echo " $r downloading..."; done
        if [ "$FAKE" = offline ]; then
            echo "error: failed retrieving file 'core.db' from geo.mirror.pkgbuild.com : Could not resolve host: geo.mirror.pkgbuild.com"
            echo "error: failed to synchronize all databases (download library error)"
            exit 1
        fi
        echo ":: Starting full system upgrade..."
    fi
    n=$#
    echo "resolving dependencies..."
    echo "looking for conflicting packages..."
    echo
    echo "Packages ($n) $*"
    echo
    if [ "$verb" = removing ]; then
        echo "@@STEP remove"
        echo ":: Do you want to remove these packages? [Y/n] "
        echo ":: Processing package changes..."
        i=0
        for p in "$@"; do
            i=$((i + 1))
            sleep "$SPEED"
            echo "($i/$n) removing $p"
        done
    else
        echo "@@STEP install"
        echo "Total Download Size:   123.45 MiB"
        echo "Total Installed Size:  456.78 MiB"
        echo
        echo ":: Proceed with installation? [Y/n] "
        echo ":: Retrieving packages..."
        for p in "$@"; do
            sleep "$SPEED"
            echo " $p-1.0-1-x86_64 downloading..."
            if [ "$FAKE" = fail ] || [ "$FAKE" = offline ]; then
                echo "error: failed retrieving file '$p-1.0-1-x86_64.pkg.tar.zst' from geo.mirror.pkgbuild.com : Could not resolve host: geo.mirror.pkgbuild.com"
                echo "warning: failed to retrieve some files"
                echo "error: failed to commit transaction (failed to retrieve some files)"
                echo "Errors occurred, no packages were upgraded."
                exit 1
            fi
        done
        for step in "checking keys in keyring" "checking package integrity" "loading package files" \
                    "checking for file conflicts" "checking available disk space"; do
            i=0
            while [ $i -lt "$n" ]; do i=$((i + 1)); echo "($i/$n) $step"; done
            sleep 0.1
        done
        echo ":: Processing package changes..."
        i=0
        for p in "$@"; do
            i=$((i + 1))
            sleep "$SPEED"
            echo "($i/$n) installing $p"
        done
    fi
    echo ":: Running post-transaction hooks..."
    echo "(1/2) Arming ConditionNeedsUpdate..."
    sleep 0.2
    echo "(2/2) Updating the desktop file MIME type cache..."
    after_install
    echo "@@STEP done"
    exit 0
}

run_pacman() {
    # run_pacman <sync:0|1> <install|remove> <pkg>...
    if [ -n "$FAKE" ]; then
        verb=installing
        [ "$2" = remove ] && verb=removing
        s=$1
        shift 2
        fake_pacman "$s" "$verb" "$@"
    fi
    case $2 in
    install)
        if [ "$1" = 1 ]; then
            echo "@@STEP sync"
            shift 2
            pacman -Syu --needed --noconfirm "$@"
        else
            echo "@@STEP install"
            shift 2
            pacman -S --needed --noconfirm "$@"
        fi ;;
    remove)
        echo "@@STEP remove"
        shift 2
        pacman -Rns --noconfirm "$@" ;;
    esac
    rc=$?
    if [ $rc = 0 ]; then
        after_install
        echo "@@STEP done"
    fi
    exit $rc
}

cmd=$1
[ $# -gt 0 ] && shift
case $cmd in
install)
    check_names "$@"
    check_lock
    run_pacman 0 install "$@" ;;
remove)
    check_names "$@"
    for p in "$@"; do
        for q in $PROTECTED; do
            [ "$p" = "$q" ] && fail protected "$p is an essential system package"
        done
    done
    check_lock
    run_pacman 0 remove "$@" ;;
enable-multilib)
    check_lock
    enable_multilib
    echo "@@STEP done" ;;
enable-repo)
    repo=$1
    [ $# -gt 0 ] && shift
    known=
    for r in $KNOWN_REPOS; do
        [ "$repo" = "$r" ] && known=1
    done
    [ -n "$known" ] || fail usage "unknown repository: $repo (known: $KNOWN_REPOS)"
    [ $# -gt 0 ] && check_names "$@"
    check_lock
    enable_repo "$repo"
    sync_repo "$repo"
    if [ $# -eq 0 ]; then
        echo "@@STEP done"
        exit 0
    fi
    # <repo>/<pkg>: the packages can only come from the repository just enabled
    pkgs=
    for p in "$@"; do pkgs="$pkgs $repo/$p"; done
    # shellcheck disable=SC2086
    run_pacman 0 install $pkgs ;;
prepare-gaming)
    check_names "$@"
    check_lock
    multilib_enabled || enable_multilib
    for p in "$@"; do
        [ "$p" = gamemode ] && AFTER_GAMEMODE=1
    done
    # One transaction that also syncs and upgrades: installing lib32 packages after a
    # bare "pacman -Sy" would be a partial upgrade
    run_pacman 1 install "$@" ;;
*)
    fail usage "usage: lingmo-store-helper install|remove|enable-multilib|enable-repo|prepare-gaming [args]" ;;
esac
